# Copy to .env, then edit. Read by manage.py only: the uvicorn and gunicorn
# entry points do not load this file, so export these into the environment
# before running a server directly.

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=1

# Required. sqlite is fine for a local look; use Postgres for anything real,
# because that is what production runs and the two do not always agree.
DATABASE_URL=sqlite:///tuckit.sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/tuckit
